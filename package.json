{
  "name": "workflow-release",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "nuxt dev --host 127.0.0.1 --port 3008",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview --host 127.0.0.1 --port 3008",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck && vue-tsc --noEmit -p tests/tsconfig.json",
    "test": "vitest run",
    "test:http": "tsx tools/check-release.ts --http-only",
    "figma:read": "tsx tools/read-figma.ts",
    "test:ui": "tsx tools/check-release.ts",
    "verify:visual": "tsx tools/check-release.ts",
    "db:local": "tsx tools/local-db.ts",
    "db:init": "node --env-file=.env --import tsx tools/init-db.ts",
    "lint": "eslint . --max-warnings 0",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project nuxt",
    "test:e2e": "tsx tools/check-release.ts",
    "prebuild": "tsx tools/generate-seo.ts && tsx tools/optimize-images.ts",
    "seo:generate": "tsx tools/generate-seo.ts",
    "images:optimize": "tsx tools/optimize-images.ts",
    "perf": "tsx tools/measure-performance.ts",
    "arch:check": "tsx tools/check-architecture.ts",
    "arch:report": "tsx tools/check-architecture.ts --report=docs/architecture/after.json",
    "compose:env": "tsx tools/compose-env.ts",
    "start": "node --env-file=.env .output/server/index.mjs",
    "release:scan": "tsx tools/scan-release.ts",
    "test:release": "tsx tools/check-release.ts"
  },
  "dependencies": {
    "@fontsource-variable/montserrat": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/nunito-sans": "^5.3.0",
    "@pinia/nuxt": "^1.0.3",
    "@vue/devtools-api": "^8.2.1",
    "nuxt": "4.6.4",
    "pg": "^8.23.1",
    "pinia": "^4.1.0",
    "vue": "^3.5.0",
    "vue-router": "^5.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.4.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@vue/test-utils": "^2.6.0",
    "chrome-launcher": "^1.2.3",
    "eslint": "^10.15.0",
    "happy-dom": "^21.0.4",
    "lighthouse": "^13.6.0",
    "pixelmatch": "^8.0.0",
    "playwright": "^1.65.1",
    "pngjs": "^7.0.0",
    "sharp": "^0.35.5",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^5.1.1",
    "vue-tsc": "^3.1.0"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=27.0.0"
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "11.0.1",
    "glob@>=9.0.0 <=14.0.1": "14.0.2"
  }
}
